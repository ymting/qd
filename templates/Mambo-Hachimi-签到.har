[
  {
    "comment": "【使用说明】适用于 ymting/qd:20260716.2 或更新镜像。cookie 填浏览器当前完整 Cookie；verification_token 填本站签到弹窗中完成 Cloudflare Turnstile 后获取的短期令牌。Cloudflare 的 cf_clearance 只能复用，不能代替本站 Turnstile verificationToken；浏览器指纹变量留空默认 chrome + auto。",
    "request": {
      "method": "GET",
      "url": "https://mambo-hachimi.biliblili.uk/api/checkin/status",
      "headers": [
        {
          "name": "X-QD-Impersonate",
          "value": "{{browser_fingerprint | default('chrome', true)}}"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{browser_user_agent | default('auto', true)}}"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://mambo-hachimi.biliblili.uk/dashboard"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^200$",
          "from": "status"
        },
        {
          "re": "\\\"success\\\"\\s*:\\s*true",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "Just a moment|cf-chl|challenge-platform|未授权",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "has_checked_in_today",
          "re": "\\\"hasCheckedInToday\\\"\\s*:\\s*(true|false)",
          "from": "content"
        },
        {
          "name": "checked_amount",
          "re": "\\\"amount\\\"\\s*:\\s*([0-9]+(?:\\.[0-9]+)?)",
          "from": "content"
        },
        {
          "name": "currency_unit",
          "re": "\\\"currencyUnit\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "未签到才提交签到。本站对签到强制启用 Cloudflare Turnstile，因此 verification_token 必须由用户在浏览器的签到验证弹窗中完成验证后手工更新；不能使用脚本绕过。",
    "request": {
      "method": "POST",
      "url": "https://mambo-hachimi.biliblili.uk/api/checkin",
      "headers": [
        {
          "name": "X-QD-Impersonate",
          "value": "{{browser_fingerprint | default('chrome', true)}}"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{browser_user_agent | default('auto', true)}}"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Origin",
          "value": "https://mambo-hachimi.biliblili.uk"
        },
        {
          "name": "Referer",
          "value": "https://mambo-hachimi.biliblili.uk/dashboard"
        }
      ],
      "cookies": [],
      "data": "{\\\"verificationToken\\\":\\\"{{verification_token}}\\\"}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^(?:200|400)$",
          "from": "status"
        },
        {
          "re": "\\\"success\\\"\\s*:\\s*true|\\\"hasCheckedIn\\\"\\s*:\\s*true|已经签到",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "Just a moment|cf-chl|challenge-platform|未授权|Turnstile|验证失败|reCAPTCHA",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "sign_message",
          "re": "\\\"message\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"",
          "from": "content"
        },
        {
          "name": "sign_amount",
          "re": "\\\"amount\\\"\\s*:\\s*([0-9]+(?:\\.[0-9]+)?)",
          "from": "content"
        },
        {
          "name": "sign_balance",
          "re": "\\\"balance\\\"\\s*:\\s*([0-9]+(?:\\.[0-9]+)?)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "签到后复查状态。",
    "request": {
      "method": "GET",
      "url": "https://mambo-hachimi.biliblili.uk/api/checkin/status",
      "headers": [
        {
          "name": "X-QD-Impersonate",
          "value": "{{browser_fingerprint | default('chrome', true)}}"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{browser_user_agent | default('auto', true)}}"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://mambo-hachimi.biliblili.uk/dashboard"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^200$",
          "from": "status"
        },
        {
          "re": "\\\"success\\\"\\s*:\\s*true",
          "from": "content"
        },
        {
          "re": "\\\"hasCheckedInToday\\\"\\s*:\\s*true",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "Just a moment|cf-chl|challenge-platform|未授权",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "final_amount",
          "re": "\\\"amount\\\"\\s*:\\s*([0-9]+(?:\\.[0-9]+)?)",
          "from": "content"
        },
        {
          "name": "final_currency_unit",
          "re": "\\\"currencyUnit\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "推送签到结果。",
    "request": {
      "method": "POST",
      "url": "api://util/push",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "content=Mambo%20Hachimi%20%E7%AD%BE%E5%88%B0%E7%BB%93%E6%9E%9C%EF%BC%9A{{sign_message | default('已完成或今天已签到', true)}}%EF%BC%9B%E5%A5%96%E5%8A%B1%EF%BC%9A{{sign_amount | default(final_amount, true)}}%20{{final_currency_unit | default(currency_unit, true)}}%EF%BC%9B%E7%AD%BE%E5%88%B0%E7%8A%B6%E6%80%81%EF%BC%9A{{has_checked_in_today}}%20%28v20260915.1%29"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ]
    }
  }
]
