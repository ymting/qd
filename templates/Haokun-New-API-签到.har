[
  {
    "comment": "【好坤 API rc.22 登录与会话校验】login_mode 填 cookie（默认）时：填写包含 new_api_refresh 的浏览器完整 Cookie，模板用 POST /api/user/auth/refresh 换取短期 access_token；填 password 时：填写 username、password，cookie 留空，模板用 POST /api/user/login 获取同样的 AuthBundle。后续签到请求统一发送 Authorization: Bearer access_token，不再要求额外用户 ID 请求头。该站点登录页当前不要求勾选条款，模板不支持二次验证；Cookie、密码和令牌勿写入模板文件。",
    "request": {
      "method": "POST",
      "url": "https://api.haokun.cc{{ '/api/user/auth/refresh' if (login_mode | default('cookie', true)) == 'cookie' else '/api/user/login' }}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{ cookie if (login_mode | default('cookie', true)) == 'cookie' else '' }}"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/125.0.0.0 Safari/537.36"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://api.haokun.cc/profile"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Origin",
          "value": "https://api.haokun.cc"
        }
      ],
      "cookies": [],
      "data": "{{ '{}' if (login_mode | default('cookie', true)) == 'cookie' else {'username': (username | default('', true)), 'password': (password | default('', true))} | tojson }}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\\\"success\\\"\\s*:\\s*true",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "\\\"require_2fa\\\"\\s*:\\s*true|未登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "account_name",
          "re": "\\\"username\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"",
          "from": "content"
        },
        {
          "name": "account_quota",
          "re": "\\\"quota\\\"\\s*:\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "access_token",
          "re": "\\\"access_token\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "读取今日签到状态；若当天已经签到，后续提交会按幂等成功处理。",
    "request": {
      "method": "GET",
      "url": "https://api.haokun.cc/api/user/checkin",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ access_token }}"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/125.0.0.0 Safari/537.36"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://api.haokun.cc/profile"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\\\"success\\\"\\s*:\\s*true",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "未登录|请先登录|签到功能未启用",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "checked_in_today",
          "re": "\\\"checked_in_today\\\"\\s*:\\s*(true|false)",
          "from": "content"
        },
        {
          "name": "total_checkins",
          "re": "\\\"total_checkins\\\"\\s*:\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "total_quota",
          "re": "\\\"total_quota\\\"\\s*:\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "min_quota",
          "re": "\\\"min_quota\\\"\\s*:\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "max_quota",
          "re": "\\\"max_quota\\\"\\s*:\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交站点原生“立即签到”对应的 POST /api/user/checkin 请求；已签到响应按成功处理。",
    "request": {
      "method": "POST",
      "url": "https://api.haokun.cc/api/user/checkin",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ access_token }}"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/125.0.0.0 Safari/537.36"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://api.haokun.cc/profile"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Origin",
          "value": "https://api.haokun.cc"
        }
      ],
      "cookies": [],
      "data": "{}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\\\"success\\\"\\s*:\\s*true|签到",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "Turnstile|验证失败|签到功能未启用|未登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "sign_message",
          "re": "\\\"message\\\"\\s*:\\s*\\\"([^\\\"]*)\\\"",
          "from": "content"
        },
        {
          "name": "quota_awarded",
          "re": "\\\"quota_awarded\\\"\\s*:\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "checkin_date",
          "re": "\\\"checkin_date\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "签到后复查状态，确保今日状态已更新为已签到。",
    "request": {
      "method": "GET",
      "url": "https://api.haokun.cc/api/user/checkin",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ access_token }}"
        },
        {
          "name": "User-Agent",
          "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/125.0.0.0 Safari/537.36"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://api.haokun.cc/profile"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\\\"success\\\"\\s*:\\s*true",
          "from": "content"
        },
        {
          "re": "\\\"checked_in_today\\\"\\s*:\\s*true",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "未登录|请先登录|签到功能未启用",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "final_checked_in_today",
          "re": "\\\"checked_in_today\\\"\\s*:\\s*(true|false)",
          "from": "content"
        },
        {
          "name": "final_total_checkins",
          "re": "\\\"total_checkins\\\"\\s*:\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "final_total_quota",
          "re": "\\\"total_quota\\\"\\s*:\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成 QD 推送日志；不输出密码、Cookie 或会话令牌。",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=好坤 API签到结果：{{sign_message | default('已完成或今日已签到', true)}}，账号：{{account_name | default('已登录用户', true)}}，本次奖励：{{quota_awarded | default('未返回', true)}}，累计签到：{{final_total_checkins | default(total_checkins, true)}} 天，累计额度：{{final_total_quota | default(total_quota, true)}}，模板版本：v20260915.1"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\\\"状态\\\"\\s*:\\s*\\\"200\\\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\\\"转换后\\\"\\s*:\\s*\\\"(.*)\\\"",
          "from": "content"
        }
      ]
    }
  }
]
