          "value": "{{browser_fingerprint | default('chrome', true)}}"
        },
        {
          "name": "User-Agent",
          "value": "{{browser_user_agent | default('auto', true)}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://www.52pojie.cn/"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^200$",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?#站点返回 5xx 或请求在传输层失败（常见于 curl 超时或连接中断），未取得签到结果；请检查 QD 出口网络，必要时在 .env 提高 REQUEST_TIMEOUT 与 CONNECT_TIMEOUT 后重试)^(?:0|5\\d\\d)$",
          "from": "status"
        },
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "您需要先登录才能继续本操作|请先登录|登录后才能",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "coin",
          "re": "吾爱币: </em>(\\d+ CB)|\\Z()",
          "from": "content"
        },
        {
          "name": "reputation",
          "re": "威望: </em>(\\d+ 点)|\\Z()",
          "from": "content"
        },
        {
          "name": "contribution",
          "re": "贡献值: </em>(\\d+ 点)|\\Z()",
          "from": "content"
        },
        {
          "name": "reward",
          "re": "悬赏值: </em>(\\d+ 点)|\\Z()",
          "from": "content"
        },
        {
          "name": "adoption_rate",
          "re": "采纳率: </em>(\\d+ %)|\\Z()",
          "from": "content"
        },
        {
          "name": "enthusiasm",
          "re": "热心值: </em>(\\d+ 点)|\\Z()",
          "from": "content"
        },
        {
          "name": "violations",
          "re": "违规: </em>(\\d+ 次)|\\Z()",
          "from": "content"
        },
        {
          "name": "score",
          "re": "积分: </em>(\\d+)|\\Z()",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成签到日志，并输出模板版本号以便确认实际运行的模板。",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "html_unescape=false&content={{ ('签到结果：【' ~ (sign_message if sign_message else ('今日已签到，未重复领取奖励' if verify_state == 'verify_ok' else '未取得明确签到完成状态，请核对任务页面')) ~ '】\\r\\n' ~ '吾爱币：【' ~ (coin|default('未返回', true)) ~ '】' ~ '，威望：【' ~ (reputation|default('未返回', true)) ~ '】' ~ '，贡献值：【' ~ (contribution|default('未返回', true)) ~ '】' ~ '，悬赏值：【' ~ (reward|default('未返回', true)) ~ '】' ~ '，采纳率：【' ~ (adoption_rate|default('未返回', true)) ~ '】' ~ '，热心值：【' ~ (enthusiasm|default('未返回', true)) ~ '】' ~ '，违规：【' ~ (violations|default('未返回', true)) ~ '】' ~ '，积分：【' ~ (score|default('未返回', true)) ~ '】' ~ '（模板 v20260915.1）')|urlencode }}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?!200$).+$",
          "from": "status"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
