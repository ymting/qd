[
  {
    "comment": "【模板 v20260915.1】访问首页并建立浏览器验证会话：需要 QD 20260716.2 或更新镜像。cookie 填浏览器当前完整 Cookie；browser_fingerprint、browser_user_agent 留空即可使用 chrome + auto。若本步 403，请在浏览器重新登录、完成验证后立即更新 Cookie。",
    "request": {
      "method": "GET",
      "url": "https://www.52pojie.cn/",
      "headers": [
        {
          "name": "X-QD-Impersonate",
          "value": "{{browser_fingerprint | default('chrome', true)}}"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{browser_user_agent | default('auto', true)}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://www.52pojie.cn/"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^200$",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?#站点返回 5xx 或请求在传输层失败（常见于 curl 超时或连接中断），未取得签到结果；请检查 QD 出口网络，必要时在 .env 提高 REQUEST_TIMEOUT 与 CONNECT_TIMEOUT 后重试)^(?:0|5\\d\\d)$",
          "from": "status"
        },
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "您需要先登录才能继续本操作|请先登录|登录后才能",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "领取签到任务：接受 200 或 302；缺失 dynamicurl 必须清空，不能沿用上轮变量。",
    "request": {
      "method": "GET",
      "url": "https://www.52pojie.cn/home.php?mod=task&do=apply&id=2",
      "headers": [
        {
          "name": "X-QD-Impersonate",
          "value": "{{browser_fingerprint | default('chrome', true)}}"
        },
        {
          "name": "User-Agent",
          "value": "{{browser_user_agent | default('auto', true)}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://www.52pojie.cn/"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^(?:200|302)$",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?#站点返回 5xx 或请求在传输层失败（常见于 curl 超时或连接中断），未取得签到结果；请检查 QD 出口网络，必要时在 .env 提高 REQUEST_TIMEOUT 与 CONNECT_TIMEOUT 后重试)^(?:0|5\\d\\d)$",
          "from": "status"
        },
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "您需要先登录才能继续本操作|请先登录|登录后才能|name=[\"\\x27]loginform|id=[\"\\x27]loginform",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "response_status",
          "re": "^([\\s\\S]*)$",
          "from": "status"
        },
        {
          "name": "redirect_location",
          "re": "^([\\s\\S]*)$",
          "from": "header-location"
        },
        {
          "name": "url_key",
          "re": "(?:dynamicurl\\|(?=[^|]+\\|)|\\Z)([^|]*)",
          "from": "content"
        },
        {
          "name": "current_url",
          "re": "^([\\s\\S]*)$",
          "from": "header-X-QD-Reset-Not-Present"
        },
        {
          "name": "visited_urls",
          "re": "^([\\s\\S]*)$",
          "from": "header-X-QD-Reset-Not-Present"
        }
      ]
    }
  },
