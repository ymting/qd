  {
    "comment": "领取任务跳转：只接受 HTTPS 同站 Location，支持绝对、根相对、相对路径；发送 Cookie 前拒绝登录、外站、缺失地址及循环。",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "html_unescape=false&content={% set path = '' %}{% set ignored = '' %}{% set raw = redirect_location %}{% set base = ('https://www.52pojie.cn/home.php?mod=task&do=apply&id=2') if (loop_index|int) == 1 else current_url %}{% set seen = [('https://www.52pojie.cn/home.php?mod=task&do=apply&id=2')] if (loop_index|int) == 1 else visited_urls.split(\" \") %}{% set origin = 'https://www.52pojie.cn' %}{% set valid = raw and regex_search(raw, '^[A-Za-z0-9_~!$&()*+,;=:@%./?#-]+\\\\Z') %}{% if raw.startswith(origin + '/') %}{% set path = raw[origin|length:] %}{% elif raw.startswith('//www.52pojie.cn/') %}{% set path = raw[16:] %}{% elif raw.startswith('//') or regex_search(raw, '^[^/?#]*:') %}{% set valid = false %}{% set path = '' %}{% else %}{% set path = raw %}{% endif %}{% set path = path.split('#')[0] %}{% if not path %}{% set valid = false %}{% endif %}{% if regex_search(path, '(?i)(member[.]php|mod=logging|action=login|/login)') %}{% set valid = false %}{% endif %}{% set basepath = base[origin|length:].split('?')[0] %}{% if path.startswith('?') %}{% set path = basepath + path %}{% elif not path.startswith('/') %}{% set path = basepath.rsplit('/', 1)[0] + '/' + path %}{% endif %}{% set parts = path.split('?', 1) %}{% set segments = [] %}{% for segment in parts[0].split('/') %}{% if segment == '..' %}{% if segments %}{% set ignored = segments.pop() %}{% endif %}{% elif segment and segment != '.' %}{% set ignored = segments.append(segment) %}{% endif %}{% endfor %}{% set next_url = origin + '/' + segments|join('/') + ('/' if parts[0].endswith('/') and segments else '') + ('?' + parts[1] if parts|length > 1 else '') %}{% if not valid %}{{ '校验失败：Location或动态地址缺失、非法、外站或登录跳转'|urlencode }}{% elif next_url in seen %}{{ '校验失败：检测到重复跳转或循环'|urlencode }}{% else %}{{ ('校验通过|next_url=' + next_url + '|visited=' + ((seen + [next_url])|join(' ')) + '|')|urlencode }}{% endif %}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"转换后\"\\s*:\\s*\"校验通过",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?!200$).+$",
          "from": "status"
        },
        {
          "re": "校验失败：(?:Location或动态地址缺失、非法、外站或登录跳转|检测到重复跳转或循环|跳转超过3次，未到达200页面)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "current_url",
          "re": "\\|next_url=([^|]*)\\|",
          "from": "content"
        },
        {
          "name": "visited_urls",
          "re": "\\|visited=([^|]*)\\|",
          "from": "content"
        }
      ]
    }
  },
