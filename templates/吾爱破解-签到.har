          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://www.52pojie.cn/"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^(?:200|302)$",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?#站点返回 5xx 或请求在传输层失败（常见于 curl 超时或连接中断），未取得签到结果；请检查 QD 出口网络，必要时在 .env 提高 REQUEST_TIMEOUT 与 CONNECT_TIMEOUT 后重试)^(?:0|5\\d\\d)$",
          "from": "status"
        },
        {
          "re": "^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "您需要先登录才能继续本操作|请先登录|登录后才能|name=[\"\\x27]loginform|id=[\"\\x27]loginform",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "response_status",
          "re": "^([\\s\\S]*)$",
          "from": "status"
        },
        {
          "name": "redirect_location",
          "re": "^([\\s\\S]*)$",
          "from": "header-location"
        },
        {
          "name": "url_key",
          "re": "(?:dynamicurl\\|(?=[^|]+\\|)|\\Z)([^|]*)",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "url": "{% endif %}",
      "method": "GET",
      "headers": [],
      "cookies": []
    },
    "rule": {}
  },
  {
    "request": {
      "url": "{% endfor %}",
      "method": "GET",
      "headers": [],
      "cookies": []
    },
    "rule": {}
  },
  {
    "comment": "动态验证跳转：最多跟随 3 次跳转，只有到达 200 页面才继续。",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "html_unescape=false&content={{ ('校验通过：跳转结束' if response_status == '200' else '校验失败：跳转超过3次，未到达200页面')|urlencode }}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"转换后\"\\s*:\\s*\"校验通过",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(?!200$).+$",
          "from": "status"
        },
        {
          "re": "校验失败：(?:Location或动态地址缺失、非法、外站或登录跳转|检测到重复跳转或循环|跳转超过3次，未到达200页面)",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "request": {
      "url": "{% endif %}",
      "method": "GET",
      "headers": [],
      "cookies": []
    },
    "rule": {}
  },
  {
    "comment": "领取奖励：本步只确认 HTTP 200 与登录有效，不直接用正文判定签到结果，避免把「网站返回非进行中任务」误报为失败。",
    "request": {
      "method": "GET",
      "url": "https://www.52pojie.cn/home.php?mod=task&do=draw&id=2",
      "headers": [
        {
          "name": "X-QD-Impersonate",
          "value": "{{browser_fingerprint | default('chrome', true)}}"
        },
        {
          "name": "User-Agent",
          "value": "{{browser_user_agent | default('auto', true)}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://www.52pojie.cn/"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^200$",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?#站点返回 5xx 或请求在传输层失败（常见于 curl 超时或连接中断），未取得签到结果；请检查 QD 出口网络，必要时在 .env 提高 REQUEST_TIMEOUT 与 CONNECT_TIMEOUT 后重试)^(?:0|5\\d\\d)$",
          "from": "status"
        },
        {
          "re": "(?#登录或访问受限，未取得明确签到完成状态)^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "(?#网站要求登录，未取得明确签到完成状态)您需要先登录才能继续本操作|请先登录|登录后才能|name=[\"\\x27]loginform|id=[\"\\x27]loginform",
          "from": "content"
        },
        {
          "re": "(?#响应不是200，未取得明确签到完成状态)^(?!200$).+$",
          "from": "status"
        }
      ],
      "extract_variables": [
        {
          "name": "sign_message",
          "re": "<p\\b[^>]*>\\s*((?:恭喜您，任务已成功完成，您将收到奖励通知，请注意查收[。！!]?|(?:您)?(?:今日|今天)(?:已|已经)(?:完成签到|签到)[。！!]?|抱歉，您今天已经签过到了哦！))\\s*</p>|\\Z()",
          "from": "content"
        },
        {
          "name": "draw_state",
          "re": "(恭喜您，任务已成功完成，您将收到奖励通知，请注意查收[。！!]?|(?:您)?(?:今日|今天)(?:已|已经)(?:完成签到|签到)[。！!]?|抱歉，您今天已经签过到了哦！|不是进行中的任务)|\\Z()",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "明确成功提示优先：已取得明确成功提示时跳过状态复核，不额外请求任务详情页。",
    "request": {
      "url": "{% if sign_message %}",
      "method": "GET",
      "headers": [],
      "cookies": []
    },
    "rule": {}
  },
  {
    "comment": "未取得明确成功提示（含网站返回非进行中任务）：进入任务详情复核。",
    "request": {
      "url": "{% else %}",
      "method": "GET",
      "headers": [],
      "cookies": []
    },
    "rule": {}
  },
  {
    "comment": "任务详情复核：仅在领取奖励未取得明确成功提示时执行。读取该任务在网站上的真实状态，用于区分「本期已完成」与「本轮领取未生效」。",
    "request": {
      "method": "GET",
      "url": "https://www.52pojie.cn/home.php?mod=task&do=view&id=2",
      "headers": [
        {
          "name": "X-QD-Impersonate",
          "value": "{{browser_fingerprint | default('chrome', true)}}"
        },
        {
          "name": "User-Agent",
          "value": "{{browser_user_agent | default('auto', true)}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Referer",
          "value": "https://www.52pojie.cn/"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^200$",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?#站点返回 5xx 或请求在传输层失败（常见于 curl 超时或连接中断），未取得签到结果；请检查 QD 出口网络，必要时在 .env 提高 REQUEST_TIMEOUT 与 CONNECT_TIMEOUT 后重试)^(?:0|5\\d\\d)$",
          "from": "status"
        },
        {
          "re": "(?#登录或访问受限，无法复核任务状态)^(?:401|403|429)$",
          "from": "status"
        },
        {
          "re": "(?#网站要求登录，无法复核任务状态)您需要先登录才能继续本操作|请先登录|登录后才能|name=[\"\\x27]loginform|id=[\"\\x27]loginform",
          "from": "content"
        },
        {
          "re": "(?#任务详情响应不是200，无法复核任务状态)^(?!200$).+$",
          "from": "status"
        }
      ],
      "extract_variables": [
        {
          "name": "task_detail_done",
          "re": "(完成于|后可以再次申请|现在可以再次申请|下次可申请)|\\Z()",
          "from": "content"
        },
        {
          "name": "task_detail_can_apply",
          "re": "(立即申请)|\\Z()",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "任务详情状态归类：只有详情页明确显示本期任务已完成，才判定今日已签到；显示可立即申请说明本轮领取未生效，继续按失败处理。",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "html_unescape=false&content={% set hint = (draw_state if draw_state else '未识别到已知提示') %}{{ ('verify_ok|任务详情显示本期签到任务已完成' if (task_detail_done and not task_detail_can_apply) else (('verify_fail_reapply|任务详情显示该任务当前可立即申请，本轮领取未生效' if task_detail_can_apply else 'verify_fail_unknown|任务详情未返回可识别的任务状态') ~ '；领取奖励接口提示：' ~ hint))|urlencode }}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"转换后\"\\s*:\\s*\"verify_ok\\|",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?#响应不是 200，未取得复核结论)^(?!200$).+$",
          "from": "status"
        },
        {
          "re": "(?#本轮领取未生效，未取得明确签到完成状态)\"转换后\"\\s*:\\s*\"verify_fail_reapply\\|",
          "from": "content"
        },
        {
          "re": "(?#任务详情未返回可识别的任务状态，未取得明确签到完成状态)\"转换后\"\\s*:\\s*\"verify_fail_unknown\\|",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "verify_state",
          "re": "\"转换后\"\\s*:\\s*\"(verify_\\w+)\\|",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "url": "{% endif %}",
      "method": "GET",
      "headers": [],
      "cookies": []
    },
    "rule": {}
  },
  {
